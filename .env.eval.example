# .env.eval.example — environment for an instance under evaluation.
#
# Copy to .env.eval (gitignored, so it is safe to put real keys in) and edit:
#
#   cp .env.eval.example .env.eval
#
# Overlay, not a replacement: source it into the shell *before* launching, and
# run.py's load_dotenv() fills in everything else (API keys, JUDGE_MODEL, ...)
# from your real .env without clobbering these. python-dotenv defaults to
# override=False, so the exported values below win — the same mechanism
# eval/model_sweep.sh relies on for its inline MODEL= prefix.
#
#   cp -R context.eval/. context/          # clean, already-onboarded context
#   set -a; source .env.eval; set +a
#   python run.py
#   # in another shell:
#   python eval/finance/run_finance_evals.py
#
# The eval harness calls load_dotenv(REPO_ROOT / ".env") in its own process,
# so the LLM judge keeps your real keys and JUDGE_MODEL regardless of what is
# set here. Only the system under test is reconfigured.

# ---------------------------------------------------------------- channels --
# The WS channel is NOT disabled — the harness drives ws://localhost:8765.
# Everything else is off so nothing else can inject a turn mid-run.
EMAIL_ENABLED=false
LOCAL_UI_ENABLED=false
CURUNIR_PORTAL_URL=
CURUNIR_PORTAL_TOKEN=

# -------------------------------------------------------- background loops --
# Default to on; off here so no background job calls the model or writes into
# context/memory/ while a suite is being graded. Memory extraction is the one
# that actually bites: it fires every 60s by default.
MEMORY_EXTRACTION_ENABLED=false
DREAMING_ENABLED=false
SCHEDULER_ENABLED=false

# ------------------------------------------------------------ model config --
# llama.cpp server: `llama-server -m model.gguf --port 8080`. Its OpenAI-
# compatible route lives under /v1, and litellm needs the openai/ prefix to
# pick that dialect. The model id after the prefix is arbitrary for llama.cpp
# (it serves whatever gguf was loaded) but must be non-empty.
MODEL=openai/local
API_BASE=http://localhost:8080/v1
OPENAI_API_KEY=dummy
# OPENROUTER_PROVIDER=      # uncomment to clear a provider pinned in .env

# run.py refuses to boot when litellm.supports_vision(MODEL) is false and
# VISION_MODEL is unset — which is exactly what an unrecognized local model id
# hits. Point this at any vision-capable model you have a key for; it is only
# used if an eval task actually attaches an image.
VISION_MODEL=openai/gpt-4o-mini

# Client-side idle bound between stream chunks. Local models on CPU can be
# slow to first token, so this is well above the 120s default.
LLM_REQUEST_TIMEOUT=600

# ---------------------------------------------------------- context sizing --
# Sized for a small local context window. Raise to the production values
# (250000 / 100000) when evaluating a long-context hosted model.
MAX_HISTORY_CHARS=48000
MAX_TOOL_RESULT_CHARS=16000
MAX_ITERATIONS=40

# ---------------------------------------------------------------- persona ---
# The suite under test decides this; finance is the populated one today.
# CURUNIR_PERSONA=finance

# ---------------------------------------------------------------- logging ---
LOG_LEVEL=INFO
# LOG_FILE=/tmp/curunir-eval.log
