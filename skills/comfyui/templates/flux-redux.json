{
  "_meta": {
    "name": "flux-redux",
    "purpose": "Flux Redux: image-to-image variation. Feed a reference image, optionally nudge with a prompt, get a stylistic variation.",
    "comfyui_authored_against": "ComfyUI 0.3+ (May 2026)",
    "required_models": {
      "checkpoints": ["flux1-dev.safetensors"],
      "vaes": ["ae.safetensors"],
      "style_models": ["flux1-redux-dev.safetensors"],
      "clip_vision": ["sigclip_vision_patch14_384.safetensors"]
    },
    "editable": [
      "6.inputs.text (positive prompt — small nudge; Redux does most of the work from the image)",
      "30.inputs.image (reference image filename in ComfyUI's input/ dir)",
      "25.inputs.noise_seed (KSampler seed)",
      "27.inputs.width / height (output size)",
      "17.inputs.steps (default 20)"
    ]
  },
  "5": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": ["11", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["13", 0],
      "vae": ["10", 0]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "flux_redux",
      "images": ["8", 0]
    }
  },
  "10": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "11": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp8_e4m3fn.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "12": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-dev.safetensors",
      "weight_dtype": "default"
    }
  },
  "13": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["25", 0],
      "guider": ["22", 0],
      "sampler": ["16", 0],
      "sigmas": ["17", 0],
      "latent_image": ["5", 0]
    }
  },
  "16": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "17": {
    "class_type": "BasicScheduler",
    "inputs": {
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0,
      "model": ["12", 0]
    }
  },
  "22": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["12", 0],
      "conditioning": ["35", 0]
    }
  },
  "25": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    }
  },
  "30": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    }
  },
  "31": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "sigclip_vision_patch14_384.safetensors"
    }
  },
  "32": {
    "class_type": "CLIPVisionEncode",
    "inputs": {
      "clip_vision": ["31", 0],
      "image": ["30", 0]
    }
  },
  "33": {
    "class_type": "StyleModelLoader",
    "inputs": {
      "style_model_name": "flux1-redux-dev.safetensors"
    }
  },
  "34": {
    "class_type": "FluxGuidance",
    "inputs": {
      "guidance": 3.5,
      "conditioning": ["6", 0]
    }
  },
  "35": {
    "class_type": "StyleModelApply",
    "inputs": {
      "conditioning": ["34", 0],
      "style_model": ["33", 0],
      "clip_vision_output": ["32", 0]
    }
  }
}
