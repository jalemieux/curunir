{
  "_meta": {
    "name": "flux-kontext-edit",
    "purpose": "Local Flux Kontext in-context editing — take a source image and apply an edit instruction (pose change, expression, clothing, environment, etc.) while preserving identity. Uses ReferenceLatent to feed the source into the conditioning.",
    "comfyui_authored_against": "ComfyUI 0.20+ (May 2026)",
    "required_models": {
      "checkpoints": ["flux1-kontext-dev.safetensors"],
      "vaes": ["ae.safetensors"],
      "clip": ["t5xxl_fp16.safetensors", "clip_l.safetensors"]
    },
    "editable": [
      "41.inputs.image (source image filename in ComfyUI input/)",
      "6.inputs.text (edit instruction — describe what to change)",
      "26.inputs.guidance (guidance scale; default 2.5, range 1.5-4.0)",
      "25.inputs.noise_seed (0 = randomize, fixed int = reproducible)",
      "27.inputs.width / height (output dimensions; default 1024x1024)",
      "17.inputs.steps (default 20, bump to 30-40 for finer detail)"
    ]
  },
  "11": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp16.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "12": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-kontext-dev.safetensors",
      "weight_dtype": "default"
    }
  },
  "10": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "30": {
    "class_type": "ModelSamplingFlux",
    "inputs": {
      "model": ["12", 0],
      "max_shift": 1.15,
      "base_shift": 0.5,
      "width": 1024,
      "height": 1024
    }
  },
  "27": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "25": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    }
  },
  "16": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "17": {
    "class_type": "BasicScheduler",
    "inputs": {
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0,
      "model": ["30", 0]
    }
  },
  "41": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "SOURCE_IMAGE.png"
    }
  },
  "40": {
    "class_type": "FluxKontextImageScale",
    "inputs": {
      "image": ["41", 0]
    }
  },
  "39": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["40", 0],
      "vae": ["10", 0]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "Same woman, now turned sideways in a profile view, facing left, same white studio background, same clothing and appearance, studio photography, full body visible",
      "clip": ["11", 0]
    }
  },
  "26": {
    "class_type": "FluxGuidance",
    "inputs": {
      "guidance": 2.5,
      "conditioning": ["6", 0]
    }
  },
  "42": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": ["26", 0],
      "latent": ["39", 0]
    }
  },
  "22": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["30", 0],
      "conditioning": ["42", 0]
    }
  },
  "13": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["25", 0],
      "guider": ["22", 0],
      "sampler": ["16", 0],
      "sigmas": ["17", 0],
      "latent_image": ["27", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["13", 0],
      "vae": ["10", 0]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "kontext_edit",
      "images": ["8", 0]
    }
  }
}
