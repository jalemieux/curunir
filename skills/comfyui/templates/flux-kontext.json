{
  "_meta": {
    "name": "flux-kontext",
    "purpose": "Flux text-to-image. Edit the prompt and seed; everything else is fine to leave alone.",
    "comfyui_authored_against": "ComfyUI 0.3+ (May 2026)",
    "required_models": {
      "checkpoints": ["flux1-dev.safetensors"],
      "vaes": ["ae.safetensors"]
    },
    "editable": [
      "6.inputs.text (positive prompt)",
      "25.inputs.noise_seed (KSampler seed; set to 0 to randomize)",
      "27.inputs.width / height (output size; default 1024x1024)",
      "17.inputs.steps (default 20)",
      "26.inputs.guidance (Flux guidance scale; default 3.5)"
    ]
  },
  "5": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "a quiet harbor at dawn, soft fog, photographic",
      "clip": ["11", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["13", 0],
      "vae": ["10", 0]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "flux_kontext",
      "images": ["8", 0]
    }
  },
  "10": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "11": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp8_e4m3fn.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "12": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-dev.safetensors",
      "weight_dtype": "default"
    }
  },
  "13": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["25", 0],
      "guider": ["22", 0],
      "sampler": ["16", 0],
      "sigmas": ["17", 0],
      "latent_image": ["5", 0]
    }
  },
  "16": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "17": {
    "class_type": "BasicScheduler",
    "inputs": {
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0,
      "model": ["12", 0]
    }
  },
  "22": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["12", 0],
      "conditioning": ["26", 0]
    }
  },
  "25": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    }
  },
  "26": {
    "class_type": "FluxGuidance",
    "inputs": {
      "guidance": 3.5,
      "conditioning": ["6", 0]
    }
  }
}
