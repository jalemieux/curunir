# API key for your LLM provider
# ANTHROPIC_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# Brave Search API (used by web-search skill)
# BRAVE_API_KEY=BSA...

# CLI channel (disable for headless/Docker deployments)
# CLI_ENABLED=true

# gog file keyring password (Docker only; defaults to "curunir" if unset)
# GOG_KEYRING_PASSWORD=curunir
