# Image tag pulled from GHCR by docker-compose.yml. See docs/deployment.md.
# CURUNIR_TAG=latest
# PORTAL_TAG=latest   # local-dev only; portal deploys to render.com in prod

# Persona selection. Loads personas/<name>/persona.yaml at boot: an absolute
# skill allowlist (omit `skills:` to allow every skill on disk) and a
# `prompts/` directory layered on top of context/identity.md in the system
# prompt. Unset falls back to `default`, which ships the full skill catalog
# plus the baseline behavior prompt. Core tools are universal across personas.
# CURUNIR_PERSONA=default

# Multi-tenant hosting (#420). CURUNIR_PERSONAS hosts SEVERAL personas in one
# process: a comma-separated list builds one AgentRuntime per persona, each
# rooted at context/<persona>/ so ALL of its state forks (memory/,
# conversations/, schedules.db, portfolio.db, usage.db, identity.md, the
# workspace/ FS-tool sandbox). When set it WINS over CURUNIR_PERSONA; when unset
# the single CURUNIR_PERSONA (or default) is hosted alone. Each persona's
# FS-touching tools (read/write/edit/glob/grep) are jailed to
# context/<persona>/workspace via realpath containment so persona A's tools can
# never reach persona B's tree. (The authoritative isolation boundary is a
# container/namespace per persona; the in-process path-jail is the portable
# defense-in-depth layer shipped today — see CLAUDE.md "Multi-Tenant Hosting".)
# CURUNIR_PERSONAS=default,finance,life-coach

# Model selection (LiteLLM format: provider/model-name)
# MODEL=anthropic/claude-sonnet-4-20250514
# MODEL=openrouter/meta-llama/llama-3.1-70b-instruct
# MODEL=openai/llama3

# API base URL (for local models — ollama, llama.cpp, vllm, LM Studio)
# API_BASE=http://localhost:11434
# In Docker, use http://host.docker.internal:11434 to reach the host

# Vision model (LiteLLM format) used for image attachments when MODEL is text-only.
# At startup curunir checks litellm.supports_vision(MODEL); if false, image
# attachments are routed through VISION_MODEL for description and the resulting
# text is sent to MODEL. If MODEL lacks vision and VISION_MODEL is unset,
# curunir refuses to start. Description quality follows the model: tiny vision
# models may produce vague captions for charts/diagrams.
# VISION_MODEL=openai/gpt-4o-mini
# VISION_MODEL=openrouter/google/gemini-2.5-flash
# VISION_MODEL=gemini/gemini-2.5-flash

# Max conversation history size in characters (default: 250000 ~80k tokens)
# Lower this for local models with smaller context windows (e.g. 8000 for 4k context)
# MAX_HISTORY_CHARS=8000

# Max size of a single tool result in characters before it is truncated
# (default: 100000 ~25k tokens). Defense-in-depth: caps each tool result
# *before* it enters history so one oversized read/bash/web_fetch can't blow
# past the context window. Lower this for small-context models.
# MAX_TOOL_RESULT_CHARS=100000

# Max tool-calling iterations per agent turn (default: 75)
# Raise this for long agentic tasks; lower it to fail fast on runaway loops.
# MAX_ITERATIONS=150

# WebSocket server (cli.py channel)
# Defaults to 127.0.0.1 — set to 0.0.0.0 only if you need LAN exposure or are
# running inside a container whose host publishes the port. The pairing token
# (auto-generated at startup, stored in context/.ws-token with mode 0600) and
# an Origin allowlist enforced on upgrade are the actual access controls.
# WS_HOST=127.0.0.1
# WS_PORT=8765
# Comma-separated extra Origin entries (scheme://host) accepted on upgrade.
# Defaults to localhost/127.0.0.1 over http and https. Empty Origin and
# "null" are always accepted (covers native clients and sandboxed iframes).
# WS_ALLOWED_ORIGINS=
# Override path the CLI reads the pairing token from. Useful when the CLI
# runs on a different host than the server; otherwise cli.py reads
# context/.ws-token alongside the repo automatically.
# CURUNIR_WS_TOKEN=

# Local web console (operator-only read panels + chat, served from the
# container). Off by default. Loopback-bound; reuses the same context/.ws-token
# pairing token and Origin allowlist as the WS channel. Open it at
# http://<host>:<port>/?token=<token from context/.ws-token>. In Docker the
# compose file sets LOCAL_UI_HOST=0.0.0.0 (network isolation + token are the
# controls there, same as WS_HOST).
# LOCAL_UI_ENABLED=false
# LOCAL_UI_HOST=127.0.0.1
# LOCAL_UI_PORT=8766

# API keys for your LLM provider
# ANTHROPIC_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# Brave Search API (used by web-search, reddit-research, digest skills)
# BRAVE_API_KEY=BSA...

# xAI / Grok API (used by xai-search, reddit-research skills — web + X/Twitter search)
# XAI_API_KEY=xai-...

# Google Gemini API (used by gemini-search skill — grounded web search + YouTube summarization)
# GEMINI_API_KEY=

# FRED API (used by fred skill — macroeconomic data from St. Louis Fed)
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# SEC EDGAR (used by sec-edgar skill — official filings + XBRL fundamentals)
# SEC requires every request to identify the caller. Format: <app>/<ver> (<email>).
# SEC_USER_AGENT=curunir/0.1 (you@example.com)

# Polymarket (used by polymarket skill — live prediction-market odds)
# No key required — public Gamma API at https://gamma-api.polymarket.com


# Email channel (Fastmail — IMAP inbound / SMTP outbound)
# EMAIL_ENABLED=true
# FASTMAIL_USER=jac@curunir.ai                       # Fastmail login (full address)
# FASTMAIL_PASSWORD=your_fastmail_app_password       # an app-specific password, NOT your account password
# FASTMAIL_INBOX=jac@curunir.ai                      # the From address (defaults to FASTMAIL_USER)
#
# Multi-tenant email (#420): one Fastmail inbox PER persona. When hosting many
# personas (CURUNIR_PERSONAS), give each its own credentials with a persona
# suffix — FASTMAIL_USER__<PERSONA>, FASTMAIL_PASSWORD__<PERSONA>,
# FASTMAIL_INBOX__<PERSONA> (persona upper-cased, non-alphanumerics -> "_", e.g.
# life-coach -> LIFE_COACH). Each inbox is polled by its own channel bound to
# that persona's runtime, with a per-persona discovery cursor + pending-reply
# ledger under context/<persona>/email_state.json; inbound mail is attributed to
# the persona by the inbox it arrived on (no alias parsing). The bare
# FASTMAIL_* vars above are used ONLY in the single-persona case — they are NOT
# shared across personas (that would point every persona at one inbox); a
# persona without resolvable suffixed creds simply gets no inbox.
# FASTMAIL_USER__FINANCE=finance@curunir.ai
# FASTMAIL_PASSWORD__FINANCE=your_fastmail_app_password
# FASTMAIL_INBOX__FINANCE=finance@curunir.ai
# FASTMAIL_IMAP_HOST=imap.fastmail.com               # rarely needed
# FASTMAIL_SMTP_HOST=smtp.fastmail.com               # rarely needed
# EMAIL_POLL_INTERVAL=60
# EMAIL_ALLOWED_SENDERS=boss@example.com,colleague@example.com
# EMAIL_RESTRICT_OUTBOUND=true                       # block outbound to addresses outside the allowlist
# EMAIL_ATTACHMENT_DIR=/tmp/attachments
# EMAIL_STATE_FILE=./context/email_state.json    # keep this on a persisted volume (./context is bind-mounted in docker-compose); a tmpfs path means history is re-polled on every restart
# EMAIL_SPAM_SCORE_THRESHOLD=5.0
# EMAIL_SEND_MAX_RETRIES=5                           # total send attempts for a failed reply before it is dead-lettered
# EMAIL_SEND_RETRY_BACKOFF=30                        # base seconds for the exponential resend backoff (delay = backoff * 2**(attempt-1))
# EMAIL_FAILURE_ALERT_THRESHOLD=5                    # consecutive send/poll failures before an ERROR-level escalation fires

# Audio digest (used by the to_audio opt-in tool)
# Requires OPENAI_API_KEY. The tool calls OpenAI TTS to render text into MP3.
# TTS_MODEL=tts-1          # or tts-1-hd for higher quality (≈2× cost)
# TTS_VOICE=alloy          # alloy | echo | fable | onyx | nova | shimmer

# GitHub CLI (used by github and git-contribute skills)
# Create a fine-grained PAT at https://github.com/settings/tokens
# GH_TOKEN=ghp_...

# ComfyUI (used by the comfyui skill — driver at skills/comfyui/comfy.py)
# Same-host loopback by default. Override only if ComfyUI runs elsewhere.
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_DEFAULT_TIMEOUT_S=300

# Curunir Portal — set both to enable PortalChannel (dial out to the hosted portal)
CURUNIR_PORTAL_URL=
CURUNIR_PORTAL_TOKEN=

# Per-call LLM usage is persisted to context/usage.db (SQLite). Inspect with:
#   python -m src.usage --window 7d --by model
# For openrouter/* models curunir sends usage.include=True so the response carries
# the authoritative per-call cost (in USD) from OpenRouter.
# Logging
# Path to a log file; when set, run.py attaches a RotatingFileHandler
# (10MB × 3 backups) so agent activity is readable from inside the
# container. Docker compose sets this automatically to
# /app/workspace/curunir.log. Leave blank for stderr-only (local dev).
# LOG_FILE=/app/workspace/curunir.log
