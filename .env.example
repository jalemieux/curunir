# API key for your LLM provider
# ANTHROPIC_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# Brave Search API (used by web-search skill)
# BRAVE_API_KEY=BSA...

# CLI channel (disable for headless/Docker deployments)
# CLI_ENABLED=true

# Email channel (Gmail via gog CLI)
# EMAIL_ENABLED=true
# GOG_ACCOUNT=you@gmail.com
# EMAIL_ALLOWED_SENDERS=boss@example.com,colleague@example.com
# EMAIL_POLL_INTERVAL=60
# EMAIL_PROCESSED_LABEL=agent/processed

# gog file keyring password (Docker only; defaults to "curunir" if unset)
# GOG_KEYRING_PASSWORD=curunir
