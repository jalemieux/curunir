# Google AI Studio key, used by the backend only.
GEMINI_API_KEY=
# Gemini Live model. gemini-3.8-live is the current recommended native-audio model.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore

# OpenRouter key and the GLM model id (checked against https://openrouter.ai/api/v1/models).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2
# Point the agent at any OpenAI-compatible server instead, e.g. a local model:
#   AGENT_BASE_URL=http://127.0.0.1:11434/v1   OPENROUTER_MODEL=qwen3:8b   (Ollama, no key needed)
AGENT_BASE_URL=https://openrouter.ai/api/v1
# Seconds before an ask_agent call is reported to Gemini as a timeout.
GLM_TIMEOUT_S=30
# BLOCKING: Gemini waits silently for GLM. NON_BLOCKING: Gemini may keep talking, answer arrives with scheduling=INTERRUPT.
ASK_AGENT_BEHAVIOR=BLOCKING

HOST=127.0.0.1
PORT=8787
